# Run the requests from top to bottom using REST Client's Send Request links.
# Named responses supply real IDs; run each create request before using its ID.
# The final requests delete only the demonstration records created in this file.
@baseUrl = http://localhost:3000
@bandId = {{createBand.response.body.$._id}}
@missingBandId = {{createMissingBand.response.body.$._id}}
@sessionId = {{createSession.response.body.$._id}}
@shortSessionId = {{createShortSession.response.body.$._id}}
@longSessionId = {{createLongSession.response.body.$._id}}

### 01. Check that the API is running
# Expected: 200
GET {{baseUrl}}/health

### 02. Create a band for the demonstration
# Expected: 201
# @name createBand
POST {{baseUrl}}/api/bands
Content-Type: application/json

{
  "name": "REST Client Demo Band",
  "genre": "Rock",
  "timeZone": "Europe/Dublin",
  "description": "Temporary band for manual API testing"
}

### 03. Reject a band with an invalid name
# Expected: 400
POST {{baseUrl}}/api/bands
Content-Type: application/json

{
  "name": "A",
  "timeZone": "Europe/Dublin"
}

### 04. List bands
# Expected: 200
GET {{baseUrl}}/api/bands

### 05. Get the created band
# Expected: 200
GET {{baseUrl}}/api/bands/{{bandId}}

### 06. Update the band
# Expected: 200
PUT {{baseUrl}}/api/bands/{{bandId}}
Content-Type: application/json

{
  "description": "Updated during the REST Client demonstration"
}

### 07. Reject invalid band update data
# Expected: 400
PUT {{baseUrl}}/api/bands/{{bandId}}
Content-Type: application/json

{
  "name": " "
}

### 08. Reject an empty band update
# Expected: 400
PUT {{baseUrl}}/api/bands/{{bandId}}
Content-Type: application/json

{}

### 09. Reject an unknown band field
# Expected: 400
POST {{baseUrl}}/api/bands
Content-Type: application/json

{
  "name": "Invalid Band",
  "timeZone": "Europe/Dublin",
  "unknownField": true
}

### 10. Reject a malformed band ID
# Expected: 400
GET {{baseUrl}}/api/bands/not-an-id

### 11. Reject malformed JSON
# Expected: 400
POST {{baseUrl}}/api/bands
Content-Type: application/json

{
  "name": "Invalid JSON",
}

### 12. Create another band to obtain a guaranteed missing ID after deletion
# Expected: 201
# @name createMissingBand
POST {{baseUrl}}/api/bands
Content-Type: application/json

{
  "name": "Temporary Missing Record Band",
  "timeZone": "Europe/Dublin"
}

### 13. Delete that temporary band
# Expected: 204
DELETE {{baseUrl}}/api/bands/{{missingBandId}}

### 14. Get a band that has been deleted
# Expected: 404
GET {{baseUrl}}/api/bands/{{missingBandId}}

### 15. Update a band that has been deleted
# Expected: 404
PUT {{baseUrl}}/api/bands/{{missingBandId}}
Content-Type: application/json

{
  "name": "Updated Missing Band"
}

### 16. Delete a band that has already been deleted
# Expected: 404
DELETE {{baseUrl}}/api/bands/{{missingBandId}}

### 17. Create a 90-minute scheduled practice
# Expected: 201
# @name createSession
POST {{baseUrl}}/api/practice-sessions
Content-Type: application/json

{
  "bandId": "{{bandId}}",
  "startAt": "2026-11-05T18:00:00Z",
  "durationMinutes": 90,
  "format": "in-person",
  "locationOrLink": "Rehearsal room 1",
  "notes": "Main demonstration practice"
}

### 18. Create a 60-minute completed practice
# Expected: 201
# @name createShortSession
POST {{baseUrl}}/api/practice-sessions
Content-Type: application/json

{
  "bandId": "{{bandId}}",
  "startAt": "2026-11-07T18:00:00Z",
  "durationMinutes": 60,
  "format": "online",
  "locationOrLink": "https://example.com/practice-room",
  "status": "completed"
}

### 19. Create a 120-minute scheduled practice
# Expected: 201
# @name createLongSession
POST {{baseUrl}}/api/practice-sessions
Content-Type: application/json

{
  "bandId": "{{bandId}}",
  "startAt": "2026-11-02T18:00:00Z",
  "durationMinutes": 120,
  "format": "in-person",
  "locationOrLink": "Rehearsal room 2",
  "status": "scheduled"
}

### 20. Reject a practice that is too short
# Expected: 400
POST {{baseUrl}}/api/practice-sessions
Content-Type: application/json

{
  "bandId": "{{bandId}}",
  "startAt": "2026-11-05T18:00:00Z",
  "durationMinutes": 10,
  "format": "in-person",
  "locationOrLink": "Rehearsal room 1"
}

### 21. Reject creation of a practice for a deleted band
# Expected: 404
POST {{baseUrl}}/api/practice-sessions
Content-Type: application/json

{
  "bandId": "{{missingBandId}}",
  "startAt": "2026-11-05T18:00:00Z",
  "durationMinutes": 90,
  "format": "in-person",
  "locationOrLink": "Rehearsal room 1"
}

### 22. List all practice sessions
# Expected: 200
GET {{baseUrl}}/api/practice-sessions

### 23. Get the main practice session
# Expected: 200
GET {{baseUrl}}/api/practice-sessions/{{sessionId}}

### 24. Reject a malformed practice session ID
# Expected: 400
GET {{baseUrl}}/api/practice-sessions/not-an-id

### 25. Update the main practice session
# Expected: 200
PUT {{baseUrl}}/api/practice-sessions/{{sessionId}}
Content-Type: application/json

{
  "notes": "Bring the new set list"
}

### 26. Reject invalid practice update data
# Expected: 400
PUT {{baseUrl}}/api/practice-sessions/{{sessionId}}
Content-Type: application/json

{
  "durationMinutes": 10
}

### 27. Reject an empty practice update
# Expected: 400
PUT {{baseUrl}}/api/practice-sessions/{{sessionId}}
Content-Type: application/json

{}

### 28. Reject changing a practice session's band
# Expected: 400
PUT {{baseUrl}}/api/practice-sessions/{{sessionId}}
Content-Type: application/json

{
  "bandId": "{{missingBandId}}"
}

### 29. Block band deletion while its practice sessions exist
# Expected: 409
DELETE {{baseUrl}}/api/bands/{{bandId}}

### 30. Filter sessions by band - expect the three demonstration practices
# Expected: 200
GET {{baseUrl}}/api/practice-sessions?bandId={{bandId}}

### 31. Filter scheduled sessions - expect two practices for this band
# Expected: 200
GET {{baseUrl}}/api/practice-sessions?bandId={{bandId}}&status=scheduled

### 32. Filter completed sessions - expect one practice for this band
# Expected: 200
GET {{baseUrl}}/api/practice-sessions?bandId={{bandId}}&status=completed

### 33. Filter by date range - expect the November 5 and 7 practices
# Expected: 200
GET {{baseUrl}}/api/practice-sessions?bandId={{bandId}}&from=2026-11-04T00:00:00Z&to=2026-11-08T23:59:59Z

### 34. Combine filters - expect only the November 5 practice
# Expected: 200
GET {{baseUrl}}/api/practice-sessions?bandId={{bandId}}&status=scheduled&from=2026-11-04T00:00:00Z&to=2026-11-08T23:59:59Z

### 35. Sort by start time ascending - expect November 2, 5, 7
# Expected: 200
GET {{baseUrl}}/api/practice-sessions?bandId={{bandId}}&sortBy=startAt&order=asc

### 36. Sort by start time descending - expect November 7, 5, 2
# Expected: 200
GET {{baseUrl}}/api/practice-sessions?bandId={{bandId}}&sortBy=startAt&order=desc

### 37. Sort by duration ascending - expect 60, 90, 120
# Expected: 200
GET {{baseUrl}}/api/practice-sessions?bandId={{bandId}}&sortBy=durationMinutes&order=asc

### 38. Sort by duration descending - expect 120, 90, 60
# Expected: 200
GET {{baseUrl}}/api/practice-sessions?bandId={{bandId}}&sortBy=durationMinutes&order=desc

### 39. Valid filter with no matching sessions - expect an empty array
# Expected: 200
GET {{baseUrl}}/api/practice-sessions?bandId={{bandId}}&from=2050-01-01T00:00:00Z

### 40. Reject an invalid status filter
# Expected: 400
GET {{baseUrl}}/api/practice-sessions?status=unknown

### 41. Reject an invalid band ID filter
# Expected: 400
GET {{baseUrl}}/api/practice-sessions?bandId=not-an-id

### 42. Reject an invalid date filter
# Expected: 400
GET {{baseUrl}}/api/practice-sessions?from=not-a-date

### 43. Reject a reversed date range
# Expected: 400
GET {{baseUrl}}/api/practice-sessions?from=2026-11-08T00:00:00Z&to=2026-11-04T00:00:00Z

### 44. Reject an unsupported sort field
# Expected: 400
GET {{baseUrl}}/api/practice-sessions?sortBy=unknownField

### 45. Reject an unsupported sort direction
# Expected: 400
GET {{baseUrl}}/api/practice-sessions?order=sideways

### 46. Reject repeated query parameters
# Expected: 400
GET {{baseUrl}}/api/practice-sessions?status=scheduled&status=completed

### 47. Reject unknown query parameters
# Expected: 400
GET {{baseUrl}}/api/practice-sessions?unexpected=true

### 48. Delete the short practice session
# Expected: 204
DELETE {{baseUrl}}/api/practice-sessions/{{shortSessionId}}

### 49. Delete the long practice session
# Expected: 204
DELETE {{baseUrl}}/api/practice-sessions/{{longSessionId}}

### 50. Delete the main practice session
# Expected: 204
DELETE {{baseUrl}}/api/practice-sessions/{{sessionId}}

### 51. Get a practice session that has been deleted
# Expected: 404
GET {{baseUrl}}/api/practice-sessions/{{sessionId}}

### 52. Update a practice session that has been deleted
# Expected: 404
PUT {{baseUrl}}/api/practice-sessions/{{sessionId}}
Content-Type: application/json

{
  "notes": "Update a missing practice"
}

### 53. Delete a practice session that has already been deleted
# Expected: 404
DELETE {{baseUrl}}/api/practice-sessions/{{sessionId}}

### 54. Delete the main band now that its sessions are gone
# Expected: 204
DELETE {{baseUrl}}/api/bands/{{bandId}}

### 55. Confirm that the main band was deleted
# Expected: 404
GET {{baseUrl}}/api/bands/{{bandId}}

### 56. Confirm that this band's sessions are gone - expect an empty array
# Expected: 200
GET {{baseUrl}}/api/practice-sessions?bandId={{bandId}}
